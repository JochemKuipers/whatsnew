{
  "name": "whatsnew",
  "description": "A Spicetify extension created with @spicetify/creator",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "sc": "spicetify-creator",
    "dev": "spicetify-creator dev",
    "build": "spicetify-creator build",
    "update-types": "spicetify-creator update-types",
    "clean-spice": "spicetify-creator clean-spicetify --all",
    "lint": "biome check --apply ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@spicemod/creator": "latest",
    "@types/bun": "^1.3.10",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@biomejs/biome": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
